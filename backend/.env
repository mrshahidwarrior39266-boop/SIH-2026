# SkillBridge Backend — Environment Variables
# Copy this file to .env and fill in your values

PORT=3001

# SECURITY — Change these to long random strings in production!
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_session_secret_too

# GOOGLE OAUTH
# 1. Go to https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# 5. Copy Client ID and Secret below
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# FRONTEND — URL where your frontend is served (for CORS + redirect after OAuth)
# If using VS Code Live Server: http://localhost:5500
# If opening as file: use http://localhost:5500 and serve via Live Server
FRONTEND_URL=http://localhost:5500
